{
  "name": "prospecto",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Instagram commercial operations system.",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "concurrently -k -n web,worker -c cyan,magenta \"next dev\" \"tsx watch src/worker/start.ts\"",
    "build": "next build",
    "start": "concurrently -k -n web,worker -c cyan,magenta \"next start\" \"tsx src/worker/start.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/simulate-e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/db/seed.ts",
    "setup:business": "tsx scripts/setup-business.ts",
    "backup": "tsx scripts/backup.ts",
    "restore:test": "tsx scripts/restore-test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm build",
    "restore": "tsx scripts/restore.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "dotenv": "17.2.2",
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "openai": "7.15.0",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.1.5",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "concurrently": "9.2.1",
    "drizzle-kit": "0.31.8",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
